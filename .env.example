# === Event Analysis Team Configuration ===

# Mode A: API Mode — Set this to use direct Anthropic API calls
# Leave empty for Mode B (Claude Code / Max subscription tokens)
ANTHROPIC_API_KEY=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Comma-separated list of authorized Telegram chat IDs
# Leave empty to allow all users
ALLOWED_CHAT_IDS=

# Claude Code path (Mode B only, defaults to 'claude' in PATH)
CLAUDE_CODE_PATH=claude
