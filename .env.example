# ──────────────────────────────────────────────
# Mode 1: Claude Max (FREE - uses Claude Code CLI)
# Leave ANTHROPIC_API_KEY empty and install Claude Code CLI on server
# npm install -g @anthropic-ai/claude-code && claude login
#
# Mode 2: API (pay-per-use)
# Set your API key below
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Allowed Telegram Chat IDs (comma-separated, empty = allow all)
ALLOWED_CHAT_IDS=

# Cloudflare Pages (optional, for report hosting)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PROJECT_NAME=analysis-reports

# Admin report list page (optional). 설정 시 admin-{token}.html 에 전체 보고서
# 목록(토큰 URL 포함)을 생성 — 고정 난수 주소라 즐겨찾기용. 미설정 시 미생성,
# 텔레그램 /reports 명령으로 대체. 추측 불가한 긴 난수 권장 (예: openssl rand -hex 16).
ADMIN_INDEX_TOKEN=

# Report output directory
REPORT_OUTPUT_DIR=reports

# ──────────────────────────────────────────────
# V5 Refactoring — Phase opt-in flags (default OFF = v4.5.7 byte-equal)
# 활성화 가이드: docs/V5_ACTIVATION.md
# 모든 flag 는 1/true/yes/on 으로 켜고 0/false/no/off 또는 비워두면 꺼짐.
# 단계적으로 켜고 회귀 테스트 (tests/regression/) 통과 확인 후 다음 phase.
# ──────────────────────────────────────────────
V5_RESEARCH_DIRECTOR=
V5_VISUAL_PLANNER=
V5_EDITOR_PASS=
V5_LAYOUT_TYPESETTER=
V5_DESK_EDITOR=

# ──────────────────────────────────────────────
# Daily Briefing Scheduler (v5.1.0)
# 매일 지정 시각에 "간밤 산업·지정학·정치·전쟁" 심층 보고서를 자동 생성하고,
# /briefing_on 명령으로 구독한 텔레그램 채팅에 송신.
# enabled=true 라도 구독자가 0명이면 분석은 스킵됨.
# 봇 프로세스 안 asyncio task — 별도 cron 불요.
# ──────────────────────────────────────────────
DAILY_BRIEFING_ENABLED=false
DAILY_BRIEFING_TIME=06:00          # HH:MM, DAILY_BRIEFING_TZ 기준
DAILY_BRIEFING_TZ=Asia/Seoul       # IANA tz (예: UTC, America/New_York, Asia/Tokyo)

# ──────────────────────────────────────────────
# Market Close Briefing Scheduler (v5.5.9)
# 평일 한국 장마감 후 (디폴트 17:00 KST) "시장 구조 해석가" 페르소나로
# 한국 주식시장 (가격·거래대금·수급·섹터·거시) 구조 해석 보고서 자동 생성.
# pykrx 거래일 캘린더로 KRX 휴장일 (주말·공휴일·임시휴장) 자동 skip.
# /market_brief_on 명령으로 구독한 텔레그램 채팅에 송신.
# 페르소나 파일 (markdown) 은 startup 시 1회 로드 + event_description 앞에 prime.
# 파일 경로는 repo 루트 기준 상대경로 또는 절대경로 (디폴트: prompts/market_briefing_persona.md).
# ──────────────────────────────────────────────
MARKET_BRIEFING_ENABLED=false
MARKET_BRIEFING_TIME=17:00         # HH:MM, MARKET_BRIEFING_TZ 기준
MARKET_BRIEFING_TZ=Asia/Seoul
MARKET_BRIEFING_PERSONA_PATH=prompts/market_briefing_persona.md

# ──────────────────────────────────────────────
# Market Data Fetcher (v5.2.0) — 시계열 차트 (line / candle / area) 데이터 소스.
# 각 키 무료. 비워두면 해당 source 의 instrument 만 빈 series 로 emit
# (보고서는 정상 진행, 차트만 skip + warning log).
#
# FRED  https://fred.stlouisfed.org/docs/api/api_key.html       — UST / WTI / 금
# ECOS  https://ecos.bok.or.kr/api/                              — 국고채 / 환율 / 한국 macro
# KRX   현재 미사용 (data.krx.co.kr public endpoint 무인증)
# YAHOO 무인증 (yfinance) — 한국·미국 지수 + 미국 개별주 (NVDA/TSLA/AAPL/MSFT/
#       GOOGL/AMZN/META/AMD/TSM/AVGO) + S&P500/나스닥/필라델피아 반도체 + DXY.
#       v5.6.9 부터 미국 빅테크/반도체 개별주 차트 지원 (키 불필요).
# ──────────────────────────────────────────────
FRED_API_KEY=
ECOS_API_KEY=
KRX_API_KEY=
