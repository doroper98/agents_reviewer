# ──────────────────────────────────────────────
# Mode 1: Claude Max (FREE - uses Claude Code CLI)
# Leave ANTHROPIC_API_KEY empty and install Claude Code CLI on server
# npm install -g @anthropic-ai/claude-code && claude login
#
# Mode 2: API (pay-per-use)
# Set your API key below
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Allowed Telegram Chat IDs (comma-separated, empty = allow all)
ALLOWED_CHAT_IDS=

# Cloudflare Pages (optional, for report hosting)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PROJECT_NAME=analysis-reports

# Report output directory
REPORT_OUTPUT_DIR=reports
