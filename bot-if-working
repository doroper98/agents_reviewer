#!/usr/bin/env bash
# bot-if-working — 지금 봇이 보고서를 작성 중인지 VM 에서 한눈에 확인.
#
# 사용법:
#   ./bot-if-working            # 사람용 요약 출력
#   ./bot-if-working --quiet    # 출력 없이 exit code 만 (0=작성중, 1=유휴, 2=봇죽음)
#   ./bot-if-working --watch    # 2초마다 갱신 (Ctrl-C 로 종료)
#
# 판별 원리 (bot.log 마커 + 프로세스):
#   - 봇 프로세스(src.main)가 없으면      → 죽음 (exit 2)
#   - 마지막 "✅ 분석 완료" 가 마지막 시작 마커보다 뒤면 → 유휴 (exit 1)
#   - 시작 마커가 더 최근이면              → 작성 중 (exit 0)
# 시작 마커: "상황 분석관" / "편집장" / "Starting CLI call" / "후속 분석 시작"
#
# 설치: 이 파일을 ~/agents_reviewer/bot-if-working 로 두고 chmod +x.
#   ln -s ~/agents_reviewer/bot-if-working ~/.local/bin/bot-if-working  (선택)

set -u

# --- 설정 (환경변수로 덮어쓰기 가능) ---
BOT_DIR="${BOT_DIR:-$HOME/agents_reviewer}"
LOG_FILE="${BOT_LOG:-$BOT_DIR/bot.log}"
# python 인터프리터가 src.main 모듈을 도는 프로세스만 매치 (vim src/main.py 같은
# 오탐 + 이 스크립트 자신의 명령줄 self-match 방지). `python -m src.main` 형태.
PROC_PATTERN="${BOT_PROC:-python.*src\.main}"
# 시작 마커 (작성 진행을 의미). 완료는 별도 변수.
START_RE='상황 분석관|편집장|Starting CLI call|후속 분석 시작|상황 분석관:'
DONE_RE='✅ 분석 완료|분석 완료 \(소요시간'

QUIET=0
WATCH=0
for arg in "$@"; do
  case "$arg" in
    --quiet|-q) QUIET=1 ;;
    --watch|-w) WATCH=1 ;;
    --help|-h)
      sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "알 수 없는 옵션: $arg (--help)" >&2; exit 3 ;;
  esac
done

# 봇 프로세스 PID 들을 찾는다. self-match 차단이 핵심:
#   - pgrep -f 는 *명령줄 전체* 를 매치 → 이 스크립트(또는 이 스크립트를 부르는
#     grep/ps 명령줄)에 패턴 문자열이 들어가면 자기 자신을 잡는다.
#   - 그래서 (a) ps 로 cmd 를 직접 받아 정규식 매치하고 (b) 이 스크립트의 PID 와
#     그 조상(부모 셸 체인)을 결과에서 제외한다.
find_bot_pids() {
  local self_chain pid
  self_chain=" $$ ${PPID:-0} "
  pid="${PPID:-0}"
  # 조상 체인 수집 (최대 6단계 — Bash tool → snapshot shell → ... 방어)
  local i=0
  while [ "$pid" -gt 1 ] && [ "$i" -lt 6 ]; do
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    [ -z "$pid" ] && break
    self_chain="$self_chain$pid "
    i=$((i + 1))
  done

  # ps 전체에서 (pid, cmd) 받아 패턴 매치 + self_chain 제외
  ps -eo pid=,args= 2>/dev/null | while read -r p rest; do
    case " $self_chain " in *" $p "*) continue ;; esac
    # cmd 가 패턴에 맞고, 'pgrep'/'grep'/'bot-if-working' 같은 도구 호출은 배제
    case "$rest" in
      *bot-if-working*|*pgrep*|*" grep "*) continue ;;
    esac
    if printf '%s' "$rest" | grep -Eq "$PROC_PATTERN"; then
      printf '%s ' "$p"
    fi
  done
}

# --- 핵심 판별 (한 번) ---
check_once() {
  # 1) 프로세스 살아있나
  local pids
  pids="$(find_bot_pids | sed 's/ $//')"
  if [ -z "$pids" ]; then
    STATE="dead"; DETAIL="$PROC_PATTERN 프로세스 없음 — 봇이 죽었거나 안 떠 있음"; RC=2
    return
  fi

  # 2) 로그 파일 존재
  if [ ! -f "$LOG_FILE" ]; then
    STATE="unknown"; DETAIL="프로세스(pid: $pids)는 살아있으나 로그 파일 없음: $LOG_FILE"; RC=1
    return
  fi

  # 3) 마지막 시작 마커 / 완료 마커 줄 번호
  local last_start last_done
  last_start="$(grep -nE "$START_RE" "$LOG_FILE" 2>/dev/null | tail -1 | cut -d: -f1)"
  last_done="$(grep -nE "$DONE_RE" "$LOG_FILE" 2>/dev/null | tail -1 | cut -d: -f1)"
  last_start="${last_start:-0}"
  last_done="${last_done:-0}"

  PIDS="$pids"
  if [ "$last_start" -eq 0 ]; then
    STATE="idle"; DETAIL="로그에 분석 시작 흔적 없음 (pid: $pids)"; RC=1
    return
  fi

  if [ "$last_start" -gt "$last_done" ]; then
    # 진행 중. 어느 단계인지 마지막 시작 마커로 추정.
    local marker
    marker="$(sed -n "${last_start}p" "$LOG_FILE" | tr -d '\r')"
    # 마지막 로그 줄 시각(파일 mtime)으로 "멈춘 지" 추정
    local age
    age="$(($(date +%s) - $(stat -c %Y "$LOG_FILE" 2>/dev/null || echo 0)))"
    STATE="working"
    DETAIL="진행 중 (pid: $pids) · 마지막 단계: ${marker:0:90} · 로그 마지막 갱신 ${age}초 전"
    RC=0
    # composer deep timeout 은 900s. 그보다 한참(>1200s) 로그가 멈췄으면 hang 의심.
    if [ "$age" -gt 1200 ]; then
      STATE="stalled"
      DETAIL="작성 시작했으나 로그가 ${age}초째 멈춤 — hang 의심 (마지막: ${marker:0:80})"
      RC=0
    fi
    return
  fi

  STATE="idle"; DETAIL="마지막 분석 완료됨 (pid: $pids) — 새 요청 대기 중"; RC=1
}

emit() {
  [ "$QUIET" -eq 1 ] && return
  local icon
  case "$STATE" in
    working) icon="🟢 작성 중" ;;
    stalled) icon="🟠 작성 중(멈춤 의심)" ;;
    idle)    icon="⚪ 유휴 (대기)" ;;
    dead)    icon="🔴 봇 죽음" ;;
    *)       icon="🟡 불명" ;;
  esac
  echo "$icon — $DETAIL"
}

if [ "$WATCH" -eq 1 ]; then
  trap 'echo; exit 0' INT
  while true; do
    check_once
    clear 2>/dev/null || true
    echo "[$(date '+%H:%M:%S')] bot-if-working ($BOT_DIR)"
    emit
    sleep 2
  done
fi

check_once
emit
exit "$RC"
